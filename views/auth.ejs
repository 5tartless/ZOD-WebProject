<!DOCTYPE html>
<html lang="es">
<%- include('partials/head') %>
<head>
    <!-- <% if (login) { %>
    <h2>Welcome back, user!</h2>
    <% } %> -->

    <title><%= login ? 'Iniciar Sesion':'Crear Cuenta' %></title>
</head>

<body>
    <%- include('partials/header') %>
    <div class="main-container">
        <form id="form">
            <h2>Ingresa tus datos:</h2>
            <div class="container">
                <label for="email">Correo:</label>
                <input type="email" id="email" required>
            </div>
            <% if (!login) {%>
                <div class="container">
                    <p>Tu nombre de usuario nos ayudara a identificarte, asegurate de que sea unico.</p>
                    <label for="username">Nombre de usuario:</label>
                    <input type="text" id="username" required>
                </div>
            <%} %>
            <div class="container">
                <label for="password">Contraseña:</label>
                <input type="password" id="password" required>
            </div>

            <% if (!login) {%>
            <h3>Otros datos:</h2>
            
            <div class="container">
                <label for="name">Nombre:</label>
                <input type="text" id="name">
            </div>
            <div class="container">
                <label for="lastName">Apellidos:</label>
                <input type="text" id="lastName">
            </div>
            <div class="container">
                <label for="direction">Provincia y canton:</label>
                <input type="text" id="direction" autocomplete="off" list="direction-list" placeholder="San Jose, Desamparados">
                <datalist id="direction-list">

                </datalist>
            </div>
            <div class="container">
                <label for="profession">Especialidad:</label>
                <input type="text" id="profession" autocomplete="off" list="profession-list" placeholder="Programacion">
                <datalist id="profession-list">

                </datalist>
            </div>
            <div class="container">
                <label for="confirm-password">Confirmar contraseña:</label>
                <input type="password" id="confirm-password" required>
            </div>
            <%} %>
            <button type="submit"><%= login ? 'Entrar':'Crear cuenta' %></button>
            <span>&nbsp;</span>
        </form>
    </div>
    <!-- For auth -->
    <script>
        const $ = el => document.querySelector(el)
        const login = ('<%= login %>' === 'true' ? true:false)
        const user = JSON.parse(`<%- typeof user !== 'undefined' ? JSON.stringify(user) : 'null' %>`)
        if (user !== null) {
            console.log(user)
            window.location.href = "/profile"
        }
        
        const $form = $('#form')
        const $span = $('#form span')
        if (!login) {
            const $directionList = $('#direction-list')
            const $professionList = $('#profession-list')
            const dOpts = JSON.parse('<%- JSON.stringify(dOpts) %>')
            const pOpts = JSON.parse('<%- JSON.stringify(pOpts) %>')
            for (opt of dOpts) {
                const option = document.createElement("option")
                option.value = opt

                $directionList.appendChild(option)
            }
            for (opt of pOpts) {
                const option = document.createElement("option")
                option.value = opt

                $professionList.appendChild(option)
            }
        }

        function doLogin (email, password, username) {
            fetch('/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({email, password})
            }).then(res => {
                if (res.ok) {
                    $span.innerText = 'Sesion iniciada.'
                    setTimeout(() => {
                        res.json().then((resUser) => {
                            window.location.href = `/profile?username=${username? username:resUser.username}`
                        })
                        
                    }, 1500);
                } else {
                    res.json().then(data => {
                        $span.innerText = data
                    })
                }
            })
        }

        $form?.addEventListener('submit', e => {
            e.preventDefault()
            const email = $('#email').value
            const password = $('#password').value
            if (!login) {
                const username = $('#username').value
                const confirmPassword = $('#confirm-password').value
                const name = $('#name').value
                const lastName = $('#lastName').value
                const direction = $('#direction').value
                const profession = $('#profession').value

                if (password !== confirmPassword) {
                    $span.innerText = 'Las contraseñas no coinciden.'
                    return
                }
                // validating that direction and profession are both valid.
                
                const dOpts = JSON.parse('<%- JSON.stringify(dOpts) %>')
                const pOpts = JSON.parse('<%- JSON.stringify(pOpts) %>')

                if (!dOpts.includes(direction)) {
                    $span.innerText = 'Direccion desconocida.'
                    return
                }
                if (!pOpts.includes(profession)) {
                    $span.innerText = "Especialidad desconocida."
                    return
                }

                fetch('/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({email, username, password, name, lastName, direction, profession})
                }).then(res => {
                    if (res.ok) {
                        $span.innerText = 'Usuario registrado.'
                        doLogin(email, password, username)
                    } else {
                        res.json().then(data => {
                            $span.innerText = data
                        })
                    }
                })
            } else {
                doLogin(email, password)
            }
        })
    </script>
</body>
</html>
